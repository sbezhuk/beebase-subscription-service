APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=8080

POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=beebase_subscription

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Apple In-App Purchase / Webhook Configuration
APPLE_BUNDLE_ID=com.beebase.production
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Sandbox

# Google Play In-App Purchase / RTDN Configuration
GOOGLE_PACKAGE_NAME=com.beebase.production
GOOGLE_SERVICE_ACCOUNT_JSON=
